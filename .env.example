# Copy to .env and fill in. Never commit .env.
# Generate tokens with:  openssl rand -hex 24

# Tokens accepted by GET endpoints (Kindle, browser). Comma-separated, ≥16 chars.
DEVICE_TOKENS=replace-with-openssl-rand-hex-24
# Tokens accepted by POST /api/ingest/usage (local usage agent). Keep separate.
INGEST_TOKENS=replace-with-another-openssl-rand-hex-24

# Only for local development: makes every endpoint public.
AUTH_DISABLED=false

# Optional overrides of config/config.yaml
# DISPLAY_TZ=Asia/Bangkok
# LOG_LEVEL=info
# KINDLE_HTML_REFRESH_SECONDS=900
# GOLD_PROVIDER=vangtoday
# GOLD_API_URL=https://www.vang.today/api/prices

# Compose uses the existing shared Redis on the external apps-network by default.
# Set REDIS_URL= explicitly to use the JSON file cache in ./data.
# REDIS_URL=redis://redis:6379/0

# Serve example data instead of calling collectors (UI preview only).
# MOCK_DATA=/app/mock/dashboard.json

# Host port published by docker compose (bound to 127.0.0.1).
HOST_PORT=8089

# URL prefix for reverse-proxy deployment; leave empty at a dedicated hostname.
# BASE_PATH=/elink-dashboard

# Production Codex usage-agent: mount only sessions, never the full Codex home.
# CODEX_SESSIONS_DIR=/home/futu/.codex/sessions
# USAGE_AGENT_UID=1000
# USAGE_AGENT_GID=1000
